# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by the app and by alembic.
DATABASE_URL=postgresql://user:password@localhost:5432/club_setup_tool

# Signs and verifies JWTs and the browser session cookie. Anyone with this value can forge a token for any
# user, so keep it out of git. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-hex-string

# Optional. Defaults live in app/core/config.py; set these only to override.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# SESSION_HTTPS_ONLY=true   # set in production behind HTTPS
