# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string used by the app and by alembic.
# postgres:// URLs (as Neon and Heroku issue them) are accepted too.
DATABASE_URL=postgresql://user:password@localhost:5432/club_setup_tool

# Signs and verifies JWTs. Anyone with this value can forge a token for any
# user, so keep it out of git. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-hex-string

# Optional. Defaults live in app/core/config.py; set these only to override.
# SESSION_HTTPS_ONLY=true            # mark the refresh cookie Secure; required in production
# ENABLE_API_DOCS=true               # serve interactive API docs at /api/docs
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14
# ALGORITHM=HS256

# Tests (the Makefile sets these defaults). Database names must contain "test".
# TEST_DATABASE_URL=postgresql://localhost:5432/club_setup_tool_test
# E2E_DATABASE_URL=postgresql://localhost:5432/club_setup_tool_e2e_test

# Frontend dev server only: where Vite proxies /api.
# API_URL=http://localhost:8000
